package AppUtils;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class pp {
	
public static WebDriver driver;

	public static void main(String[] args) {
		 driver= new ChromeDriver();
		 driver.manage().deleteAllCookies();
		 driver.manage().window().maximize();
		 driver.get("https://qapracticehub.com");
		 
		driver.findElement(By.linkText("Tables")).click();
		
		WebElement table= driver.findElement(By.id("users-table"));
		List<WebElement>rows= table.findElements(By.tagName("tr"));
		WebElement next=	driver.findElement(By.id("page-next"));
		
		for(int i=2; i<rows.size(); i++)
		{
			List<WebElement> columns=rows.get(i).findElements(By.tagName("td"));
			
			for(int j=0; j<columns.size(); j++)
			{
				String text=columns.get(j).getText();
				
				if
				(text.equals("Grace Kim")) {
					driver.findElement(By.xpath("//input[@type='checkbox']")).click();
					break;
				}
				
			}
		}
		
	

	
	}
}
		   

	   